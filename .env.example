# NEXUS Phase 1 — environment configuration (NON-SECRET values only).
# Copy to .env and adjust. Never commit real secrets: API keys, database
# passwords, JWT secrets, cloud credentials and provider tokens belong in the
# environment / secret provider, never in this file or source code.

# DEVELOPMENT | STAGING | PRODUCTION (PRODUCTION requires VITE_NEXUS_BUILD)
VITE_NEXUS_ENV=DEVELOPMENT

# Release version shown in the control plane
VITE_NEXUS_VERSION=0.1.0

# Build identifier (required in PRODUCTION)
VITE_NEXUS_BUILD=phase1-foundation

# IndexedDB database name
VITE_NEXUS_DB_NAME=nexus_platform

# Absolute session lifetime in milliseconds (default 12h)
VITE_NEXUS_SESSION_TTL_MS=43200000

# PBKDF2-HMAC-SHA256 iterations (floor 100,000)
VITE_NEXUS_PBKDF2_ITERATIONS=150000

# Engineering request length limit (characters)
VITE_NEXUS_MAX_REQUEST_CHARS=2000
